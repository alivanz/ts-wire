{
  "name": "ts-wire",
  "version": "0.1.0",
  "description": "Contract-first realtime for TypeScript — ts-rest, but for SSE (and WebSocket)",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js"
    },
    "./sse/client": {
      "types": "./dist/sse/client/index.d.ts",
      "import": "./dist/sse/client/index.js"
    },
    "./sse/fetch": {
      "types": "./dist/sse/fetch/index.d.ts",
      "import": "./dist/sse/fetch/index.js"
    },
    "./sse/node": {
      "types": "./dist/sse/node/index.d.ts",
      "import": "./dist/sse/node/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js"
    },
    "./ws/client": {
      "types": "./dist/ws/client/index.d.ts",
      "import": "./dist/ws/client/index.js"
    },
    "./ws/cf": {
      "types": "./dist/ws/cf/index.d.ts",
      "import": "./dist/ws/cf/index.js"
    },
    "./ws/node": {
      "types": "./dist/ws/node/index.d.ts",
      "import": "./dist/ws/node/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "realtime",
    "sse",
    "server-sent-events",
    "eventsource",
    "websocket",
    "contract",
    "type-safe",
    "typescript",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "Alivan Akbar <alivan1627@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivanz/ts-wire.git"
  },
  "homepage": "https://github.com/alivanz/ts-wire#readme",
  "bugs": "https://github.com/alivanz/ts-wire/issues",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.0"
  }
}
