{
  "name": "ts-wire",
  "version": "0.0.0",
  "description": "Contract-first realtime for TypeScript — ts-rest, but for SSE (and WebSocket)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js"
    },
    "./sse/client": {
      "types": "./dist/sse/client/index.d.ts",
      "import": "./dist/sse/client/index.js"
    },
    "./sse/fetch": {
      "types": "./dist/sse/fetch/index.d.ts",
      "import": "./dist/sse/fetch/index.js"
    },
    "./sse/node": {
      "types": "./dist/sse/node/index.d.ts",
      "import": "./dist/sse/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "realtime",
    "sse",
    "server-sent-events",
    "eventsource",
    "websocket",
    "contract",
    "type-safe",
    "typescript",
    "standard-schema"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.0"
  }
}
